# Base URL of the GReSym API as seen by the browser. Default: /api (same origin; the dev server proxies it).
# Set a full URL (e.g. http://localhost:5147/api) only if the API allows this origin (Cors:Origins in appsettings).
VITE_API_BASE_URL=/api
# Where the dev server proxies /api to (backend `manage.sh run api` listens on http://localhost:5147)
VITE_API_PROXY_TARGET=http://localhost:5147
